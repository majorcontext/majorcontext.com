---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../lib/products';
import TheGPLogo from '../assets/sponsors/thegp.svg';
import NeptuneLogo from '../assets/sponsors/neptune.svg';

const linkFocus = 'focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2';
---

<BaseLayout
  title="Major Context"
  description="Safe infrastructure for AI agents. Sandboxed execution, credential injection, policy enforcement, and audit logging."
>
  <div class="px-4 md:px-12 py-16 md:py-24">
    <div class="max-w-4xl mx-auto grid gap-16">
      <header class="flex items-center gap-5">
        <img src="/logo.svg" alt="" class="size-11 shrink-0" />
        <div>
          <h1 class="font-serif text-4xl md:text-5xl font-normal leading-tight tracking-tight">Major Context</h1>
          <p class="text-muted mt-1">Safe infrastructure for AI agents</p>
        </div>
      </header>

      <section aria-labelledby="projects">
        <div class="flex justify-between items-baseline gap-4 pb-3 border-b border-ink">
          <h2 id="projects" class="text-2xs font-semibold uppercase tracking-widest text-subtle">Projects</h2>
          <a href="https://github.com/majorcontext" class={`text-xs text-subtle hover:text-ink transition-colors ${linkFocus}`}>github.com/majorcontext</a>
        </div>
        <ul>
          {projects.map((project) => (
            <li
              data-product={project.id}
              class="grid md:grid-cols-[11rem_minmax(0,1fr)_10rem] gap-2 md:gap-6 items-baseline py-6 border-b border-rule"
            >
              <h3 class="text-sm font-bold uppercase tracking-[0.15em]">{project.name}</h3>
              <p class="font-serif text-xl leading-snug text-balance">{project.summary}</p>
              <div class="flex md:flex-col gap-4 md:gap-1.5 text-sm">
                {project.docsHref && (
                  <a href={project.docsHref} class={`text-accent hover:text-accent-strong transition-colors ${linkFocus}`}>
                    Documentation →
                  </a>
                )}
                {project.githubUrl && (
                  <a href={project.githubUrl} class={`text-muted hover:text-ink transition-colors ${linkFocus}`}>
                    GitHub
                  </a>
                )}
                {!project.githubUrl && <span class="text-xs text-subtle">Private</span>}
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="authors" class="grid gap-4">
        <h2 id="authors" class="sr-only">Who did it</h2>
        <div class="grid md:grid-cols-2 gap-6 text-sm leading-relaxed text-muted">
          <div>
            <h3 class="font-semibold text-ink mb-1">
              <a href="https://pupius.com" class={`underline hover:text-ink-strong ${linkFocus}`} target="_blank" rel="noopener noreferrer">Dan Pupius</a>
            </h3>
            <p class="text-pretty">Principal Engineer at TheGP, helping startups at critical moments, while exploring what it means to be AI native.</p>
          </div>
          <div>
            <h3 class="font-semibold text-ink mb-1">
              <a href="https://andybons.com" class={`underline hover:text-ink-strong ${linkFocus}`} target="_blank" rel="noopener noreferrer">Andy Bonventre</a>
            </h3>
            <p class="text-pretty">CTO at Neptune. Previously led the Go open source project and security for Stripe Link.</p>
          </div>
        </div>
      </section>

      <footer class="flex flex-wrap items-center gap-x-8 gap-y-4 pt-6 border-t border-rule">
        <span class="text-2xs font-semibold uppercase tracking-widest text-subtle">Sponsored by</span>
        <a href="https://thegp.com" aria-label="TheGP" class={`text-muted hover:text-ink transition-colors ${linkFocus}`} target="_blank" rel="noopener noreferrer">
          <TheGPLogo class="h-6 w-auto" aria-hidden="true" />
        </a>
        <a href="https://meetneptune.com" aria-label="Neptune" class={`text-muted hover:text-ink transition-colors ${linkFocus}`} target="_blank" rel="noopener noreferrer">
          <NeptuneLogo class="h-6 w-auto" aria-hidden="true" />
        </a>
      </footer>
    </div>
  </div>
</BaseLayout>
