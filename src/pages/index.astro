---
import BaseLayout from '../layouts/BaseLayout.astro';
import { products } from '../lib/products';
---

<BaseLayout
  title="Major Context"
  description="Safe infrastructure for AI agents. Sandboxed execution, credential injection, policy enforcement, and audit logging."
>
  <div class="min-h-screen flex flex-col items-center px-4 py-16 md:py-24">
    <div class="max-w-2xl w-full">
      <!-- Logo -->
      <div class="mb-8 text-center">
        <img src="/logo.svg" alt="Major Context" class="w-24 h-24 mx-auto" />
      </div>

      <!-- Title -->
      <h1 class="font-serif text-4xl md:text-5xl font-normal leading-tight tracking-tight mb-4 text-ink text-center">
        Major Context
      </h1>

      <!-- Subtitle -->
      <p class="text-lg text-muted mb-16 leading-relaxed text-center">
        Safe infrastructure for AI agents
      </p>

      <!-- Product Cards -->
      <div class="mb-16">
        <!-- Moat (primary) -->
        <a href="/moat" class="group block border border-rule p-8 mb-4 hover:border-accent transition-colors">
          <div class="mb-3">
            <h2 class="text-base font-bold tracking-[0.15em] text-ink">MOAT</h2>
          </div>
          <p class="font-serif text-2xl leading-snug text-ink-strong mb-3">
            {products.moat.tagline}
          </p>
          <p class="text-sm text-muted leading-relaxed mb-4">
            Run AI coding agents in isolated containers. Credentials are injected at the network layer — never in environment variables. Every run captures logs, HTTP traces, and a tamper-proof audit trail.
          </p>
          <span class="text-sm text-accent group-hover:text-accent-strong">
            View documentation →
          </span>
        </a>

        <!-- Secondary: Keep + Gatekeeper -->
        <div class="grid md:grid-cols-2 gap-4">
          <a href="/keep" class="group flex flex-col border border-rule p-6 hover:border-accent transition-colors">
            <div class="mb-3">
              <h2 class="text-sm font-bold tracking-[0.15em] text-ink">KEEP</h2>
            </div>
            <p class="text-sm text-muted leading-relaxed mb-4">
              {products.keep.tagline}. Declarative rules that deny, redact, or log tool calls. Works standalone or with Moat.
            </p>
            <span class="text-sm text-accent group-hover:text-accent-strong mt-auto">
              View documentation →
            </span>
          </a>

          <a href="/gatekeeper" class="group flex flex-col border border-rule p-6 hover:border-accent transition-colors">
            <div class="mb-3">
              <h2 class="text-sm font-bold tracking-[0.15em] text-ink">GATEKEEPER</h2>
            </div>
            <p class="text-sm text-muted leading-relaxed mb-4">
              {products.gatekeeper.tagline}. The TLS proxy that powers Moat's network-layer credential injection. Usable standalone for any HTTPS client.
            </p>
            <span class="text-sm text-accent group-hover:text-accent-strong mt-auto">
              View documentation →
            </span>
          </a>
        </div>
      </div>

      <!-- Who Did It -->
      <div class="mb-16">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-muted pb-3 mb-4 border-b border-rule">Who Did It</h2>

        <div class="grid md:grid-cols-2 gap-6 mb-8">
          <div>
            <h3 class="text-sm font-semibold text-ink mb-1">
              <a href="https://pupius.com" class="text-ink hover:text-ink-strong underline" target="_blank" rel="noopener noreferrer">
                Dan Pupius
              </a>
            </h3>
            <p class="text-sm text-muted leading-relaxed">
              Principal Engineer at TheGP, helping startups at critical moments, while exploring what it means to be AI native.
            </p>
          </div>

          <div>
            <h3 class="text-sm font-semibold text-ink mb-1">
              <a href="https://andybons.com" class="text-ink hover:text-ink-strong underline" target="_blank" rel="noopener noreferrer">
                Andy Bonventre
              </a>
            </h3>
            <p class="text-sm text-muted leading-relaxed">
              CTO at Neptune. Previously led the Go open source project and security for Stripe Link.
            </p>
          </div>
        </div>
      </div>

      <!-- Footer -->
      <div class="pt-8 border-t border-rule">
        <p class="text-sm text-muted text-center">
          <a href="https://github.com/majorcontext/moat" class="text-ink hover:text-ink-strong underline">moat</a>
          {' · '}
          <a href="https://github.com/majorcontext/keep" class="text-ink hover:text-ink-strong underline">keep</a>
          {' · '}
          <a href="https://github.com/majorcontext/gatekeeper" class="text-ink hover:text-ink-strong underline">gatekeeper</a>
          {' · '}
          <a href="https://github.com/majorcontext" class="text-ink hover:text-ink-strong underline">github.com/majorcontext</a>
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
