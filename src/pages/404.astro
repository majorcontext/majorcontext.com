---
import DocsLayout from '../layouts/DocsLayout.astro';
---

<DocsLayout title="Page Not Found">
  <div class="not-prose text-center py-12">
    <h1 class="font-serif text-5xl font-normal leading-tight tracking-tight mb-6">
      Page Not Found
    </h1>
    <p class="text-muted mb-8 text-lg">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a
      href="/moat"
      class="inline-block bg-accent text-paper px-6 py-3 hover:bg-accent-strong transition-colors font-mono text-sm"
    >
      Back to Documentation
    </a>
  </div>
</DocsLayout>
