---
interface Props {
  href: string;
  number?: string;
  currentPath: string;
}

const { href, number, currentPath } = Astro.props;
const isActive = currentPath.includes(href);
---

<li>
  <a
    href={href}
    aria-current={isActive ? "page" : undefined}
    class:list={[
      "flex items-baseline gap-2 py-2 text-sm border-l-2 transition-colors focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2",
      isActive
        ? "text-ink bg-paper border-transparent -mx-4 md:-mx-6 px-4 md:px-6"
        : "text-muted border-transparent hover:text-ink px-0"
    ]}
  >
    {number && <span class="text-[10px] text-muted w-6 shrink-0 tabular-nums">{number}</span>}
    <slot />
  </a>
</li>
